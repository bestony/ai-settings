#: src/Admin/Import_Export.php:86
msgid "You are not allowed to export these settings."
msgstr "你没有导出这些设置的权限。"

#: src/Admin/Import_Export.php:116
msgid "You are not allowed to import these settings."
msgstr "你没有导入这些设置的权限。"

#: src/Admin/Import_Export.php:175
msgid "Choose a settings JSON file to import."
msgstr "请选择要导入的设置 JSON 文件。"

#: src/Admin/Import_Export.php:182
msgid "The upload failed. Please try again."
msgstr "上传失败，请重试。"

#: src/Admin/Import_Export.php:191
#: src/Admin/Import_Export.php:201
msgid "The uploaded file could not be read."
msgstr "无法读取上传的文件。"

#: src/Admin/Import_Export.php:210
msgid "That file is not an AI plugin settings export."
msgstr "该文件不是 AI 插件的设置导出文件。"

#: src/Admin/Settings_Page.php:143
msgid "Settings"
msgstr "设置"

#: src/Admin/Settings_Page.php:265
msgid "These are the settings the WordPress AI plugin owns: its master switch, one switch per feature, and the per-feature provider, model and option overrides."
msgstr "这些是 WordPress AI 插件自己的设置：总开关、每个功能的开关，以及每个功能的提供商、模型与选项覆盖。"

#: src/Admin/Settings_Page.php:277
msgid "Save settings"
msgstr "保存设置"

#: src/Admin/Settings_Page.php:296
#: src/Admin/Settings_Page.php:330
#: src/Admin/Settings_Page.php:895
msgid "You are not allowed to change these settings."
msgstr "你没有修改这些设置的权限。"

#: src/Admin/Settings_Page.php:399
msgid "Enabled"
msgstr "启用"

#: src/Admin/Settings_Page.php:525
#: src/Admin/Settings_Page.php:789
msgid "(AI plugin default)"
msgstr "（AI 插件默认）"

msgid "Custom…"
msgstr "自定义…"

#: src/Admin/Settings_Page.php:568
msgid "Model ID"
msgstr "模型 ID"

#: src/Admin/Settings_Page.php:588
msgid "Not registered with WordPress by the AI plugin — only this screen writes it."
msgstr "AI 插件未向 WordPress 注册该字段——只有本页面会写入它。"

#: src/Admin/Settings_Page.php:610
msgid "Saved as on, not running:"
msgstr "已保存为开启，但未运行："

#: src/Admin/Settings_Page.php:611
msgid "the master switch is off."
msgstr "总开关处于关闭状态。"

#: src/Admin/Settings_Page.php:618
msgid "Saved as off, running:"
msgstr "已保存为关闭，但正在运行："

#: src/Admin/Settings_Page.php:619
msgid "code on this site forces it on."
msgstr "站点代码强制将其开启。"

#: src/Admin/Settings_Page.php:644
msgid "Currently running."
msgstr "当前正在运行。"

#: src/Admin/Settings_Page.php:645
msgid "Currently not running."
msgstr "当前未运行。"

#: src/Admin/Settings_Page.php:663
msgid "Enable everything"
msgstr "全部启用"

#: src/Admin/Settings_Page.php:667
msgid "Disable everything"
msgstr "全部停用"

#: src/Admin/Settings_Page.php:672
msgid "Open the AI plugin screen"
msgstr "打开 AI 插件设置页"

#: src/Admin/Settings_Page.php:258
msgid "General"
msgstr "通用"

#: src/Admin/Settings_Page.php:350
msgid "Secondary menu"
msgstr "二级菜单"

#: src/Admin/Settings_Page.php:691
msgid "Import and export"
msgstr "导入与导出"

#: src/Admin/Settings_Page.php:695
msgid "Export produces the same JSON as the AI plugin's own settings export, so the two are interchangeable. Import only writes options the AI plugin registers and rejects anything that fails its schema."
msgstr "导出的 JSON 与 AI 插件自身的设置导出格式相同，两者可以互换使用。导入只会写入 AI 插件已注册的选项，并拒绝任何未通过其 schema 校验的值。"

#: src/Admin/Settings_Page.php:704
msgid "Export settings"
msgstr "导出设置"

#: src/Admin/Settings_Page.php:716
msgid "Import settings"
msgstr "导入设置"

#: src/Admin/Settings_Page.php:752
msgid "Models"
msgstr "模型"

#: src/Admin/Settings_Page.php:756
msgid "Each feature can be pointed at a specific provider and model. Leaving every override empty keeps the AI plugin's own preference order, which is usually what you want."
msgstr "每个功能都可以指定特定的提供商与模型。全部留空则沿用 AI 插件自身的优选顺序，通常这正是你想要的。"

#: src/Admin/Settings_Page.php:781
#: src/Admin/Settings_Page.php:838
msgid "Provider"
msgstr "提供商"

#: src/Admin/Settings_Page.php:787
msgid "Keep unchanged"
msgstr "保持不变"

#: src/Admin/Settings_Page.php:799
#: src/Admin/Settings_Page.php:839
msgid "Model"
msgstr "模型"

#: src/Admin/Settings_Page.php:803
msgid "Leave empty to keep"
msgstr "留空则保持不变"

#: src/Admin/Settings_Page.php:806
msgid "Apply to"
msgstr "应用到"

#: src/Admin/Settings_Page.php:809
msgid "All features"
msgstr "全部功能"

#: src/Admin/Settings_Page.php:813
msgid "Only features that are running"
msgstr "仅正在运行的功能"

#: src/Admin/Settings_Page.php:816
msgid "Apply to all"
msgstr "应用到全部"

#: src/Admin/Settings_Page.php:837
msgid "Feature"
msgstr "功能"

#: src/Admin/Settings_Page.php:880
msgid "Save models"
msgstr "保存模型"

#. translators: %s: URL of the WordPress AI plugin on WordPress.org.
#: src/Admin/Settings_Page.php:929
#, php-format
msgid "No AI plugin options were found. Install and activate the <a href=\"%s\">AI plugin</a>, then reload this page."
msgstr "未找到 AI 插件的选项。请安装并启用 <a href=\"%s\">AI 插件</a>，然后重新加载此页面。"

#. translators: %d: number of settings.
#: src/Admin/Settings_Page.php:955
#, php-format
msgid "%d setting saved."
msgid_plural "%d settings saved."
msgstr[0] "%d 项设置已保存。"
msgstr[1] "%d 项设置已保存。"

#. translators: %d: number of switches.
#: src/Admin/Settings_Page.php:970
#, php-format
msgid "%d switch updated."
msgid_plural "%d switches updated."
msgstr[0] "%d 个开关已更新。"
msgstr[1] "%d 个开关已更新。"

#. translators: %d: number of features.
#: src/Admin/Settings_Page.php:985
#, php-format
msgid "%d model override updated."
msgid_plural "%d model overrides updated."
msgstr[0] "%d 个模型覆盖已更新。"
msgstr[1] "%d 个模型覆盖已更新。"

#. translators: %d: number of rejected settings.
#: src/Admin/Settings_Page.php:1005
#, php-format
msgid "%d setting was rejected because its value is invalid."
msgid_plural "%d settings were rejected because their values are invalid."
msgstr[0] "%d 项设置因取值无效被拒绝。"
msgstr[1] "%d 项设置因取值无效被拒绝。"

#: src/Config/Collector.php:83
msgid "Content generation"
msgstr "内容生成"

#: src/Config/Collector.php:84
msgid "Generate or rework the body of a post."
msgstr "生成或改写文章正文。"

#: src/Config/Collector.php:88
msgid "Editing assistance"
msgstr "编辑辅助"

#: src/Config/Collector.php:89
msgid "Help while you are writing, in the block editor."
msgstr "在区块编辑器中书写时提供辅助。"

#: src/Config/Collector.php:93
msgid "SEO and taxonomy"
msgstr "SEO 与分类"

#: src/Config/Collector.php:94
msgid "Metadata, permalinks and taxonomy suggestions."
msgstr "元数据、固定链接与分类建议。"

#: src/Config/Collector.php:98
msgid "Media"
msgstr "媒体"

#: src/Config/Collector.php:99
msgid "Attachments and images."
msgstr "附件与图片。"

#: src/Config/Collector.php:103
msgid "Comments"
msgstr "评论"

#: src/Config/Collector.php:104
msgid "Moderation and replies."
msgstr "评论审核与回复。"

#: src/Config/Collector.php:108
msgid "Site administration"
msgstr "站点管理"

#: src/Config/Collector.php:109
msgid "Behaviour administrators configure for the whole site."
msgstr "管理员为整个站点配置的行为。"

#: src/Config/Collector.php:113
msgid "Other"
msgstr "其他"

#: src/Config/Collector.php:114
msgid "Features this version of AI Settings does not know yet."
msgstr "本版本 AI Settings 尚未识别的功能。"

#: src/Config/Collector.php:220
msgid "Completion mode"
msgstr "补全模式"

#: src/Config/Collector.php:222
msgid "Smart suggests after any pause; Word only after a sentence ends."
msgstr "智能模式在任意停顿后提示；逐词模式仅在句子结束后提示。"

#: src/Config/Collector.php:230
msgid "Smart"
msgstr "智能"

#: src/Config/Collector.php:234
msgid "Word"
msgstr "逐词"

#: src/Config/Collector.php:240
msgid "Trigger delay (ms)"
msgstr "触发延迟（毫秒）"

#: src/Config/Collector.php:242
msgid "How long typing must pause before a suggestion is requested."
msgstr "输入停顿多久后才请求建议。"

#: src/Config/Collector.php:251
msgid "Minimum confidence (%)"
msgstr "最低置信度（%）"

#: src/Config/Collector.php:253
msgid "Suggestions scoring below this are discarded."
msgstr "低于此分数的建议会被丢弃。"

#: src/Config/Collector.php:263
msgid "Maximum words"
msgstr "最大词数"

#: src/Config/Collector.php:265
msgid "Upper bound on the length of a suggestion."
msgstr "建议文本长度的上限。"

#: src/Config/Collector.php:275
msgid "Suggest while editing headings"
msgstr "编辑标题时也给出提示"

#: src/Config/Collector.php:277
msgid "Off by default: suggestions are limited to paragraph blocks."
msgstr "默认关闭：建议仅限段落区块。"

#: src/Config/Collector.php:334
msgid "AI plugin master switch"
msgstr "AI 插件总开关"

#: src/Config/Collector.php:335
msgid "Every feature below needs this switch and its own switch to be on. A feature reports as inactive until both are enabled."
msgstr "下面的每个功能都需要此开关与它自己的开关同时开启。只有两者都启用，功能才会生效。"

